{
  "name": "pre-syp-prp-bewertung",
  "version": "0.2.0",
  "private": true,
  "description": "Kriteriengeleitete Bewertung von Schüler-Softwareprojekten über mehrere Sprints",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "dokumente": "node scripts/dokumente-pruefen.mjs",
    "pruefen": "npm run lint && npm run typecheck && npm run test && npm run dokumente && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.0",
    "@types/node": "^22.10.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
